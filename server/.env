# Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://postgres:Nexadrive@2026@localhost:5432/nexadrive_db?schema=public"

# Authentication Secrets
JWT_SECRET="nexadrive_super_secret_jwt_access_key_2026"
JWT_REFRESH_SECRET="nexadrive_super_secret_jwt_refresh_key_2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage Settings
STORAGE_UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=5368709120 # 5 GB single file limit
TRASH_RETENTION_DAYS=30

# Chapa Payment Integration
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx"
CHAPA_API_URL="https://api.chapa.co/v1"

# Frontend Client URL
CLIENT_URL="http://localhost:3000"

# OAuth Credentials (Google & GitHub)
GOOGLE_CLIENT_ID="google_oauth_client_id_placeholder"
GOOGLE_CLIENT_SECRET="google_oauth_client_secret_placeholder"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

GITHUB_CLIENT_ID="github_oauth_client_id_placeholder"
GITHUB_CLIENT_SECRET="github_oauth_client_secret_placeholder"
GITHUB_CALLBACK_URL="http://localhost:5000/api/v1/auth/github/callback"

