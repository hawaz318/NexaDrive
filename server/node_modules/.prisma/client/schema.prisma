// Prisma Schema for NexaDrive System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Visibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  storageQuota BigInt   @default(549755813888) // 512 GB in bytes (512 * 1024^3)
  usedStorage  BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  folders          Folder[]             @relation("UserFolders")
  files            File[]               @relation("UserFiles")
  refreshTokens    RefreshToken[]
  groupMemberships GroupMember[]
  receivedShares   FolderShare[]        @relation("ReceivedShares")
  createdShares    FolderShare[]        @relation("CreatedShares")
  transactions     PaymentTransaction[]
  activityLogs     ActivityLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Folder {
  id         String     @id @default(uuid())
  name       String
  parentId   String?
  parent     Folder?    @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders Folder[]   @relation("SubFolders")
  ownerId    String
  owner      User       @relation("UserFolders", fields: [ownerId], references: [id], onDelete: Cascade)
  visibility Visibility @default(PRIVATE)
  isTrashed  Boolean    @default(false)
  trashedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  files  File[]
  shares FolderShare[]

  @@map("folders")
}

model File {
  id          String     @id @default(uuid())
  name        String
  size        BigInt
  mimeType    String
  storagePath String
  folderId    String?
  folder      Folder?    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User       @relation("UserFiles", fields: [ownerId], references: [id], onDelete: Cascade)
  visibility  Visibility @default(PRIVATE)
  isTrashed   Boolean    @default(false)
  trashedAt   DateTime?
  currentVer  Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  versions FileVersion[]

  @@map("files")
}

model FileVersion {
  id          String   @id @default(uuid())
  fileId      String
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionNum  Int
  storagePath String
  size        BigInt
  createdAt   DateTime @default(now())

  @@map("file_versions")
}

model FolderShare {
  id           String       @id @default(uuid())
  folderId     String
  folder       Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User         @relation("CreatedShares", fields: [createdById], references: [id])
  sharedWithId String?
  sharedWith   User?        @relation("ReceivedShares", fields: [sharedWithId], references: [id])
  groupId      String?
  group        Group?       @relation(fields: [groupId], references: [id])
  status       InviteStatus @default(PENDING)
  permissions  String[] // E.g. ["READ", "WRITE", "DELETE", "SHARE"]
  createdAt    DateTime     @default(now())

  @@map("folder_shares")
}

model Group {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  members GroupMember[]
  shares  FolderShare[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // ADMIN or MEMBER
  createdAt DateTime @default(now())

  @@map("group_members")
}

model PaymentTransaction {
  id         String   @id @default(uuid())
  txRef      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     Float
  currency   String   @default("ETB")
  status     String // PENDING, SUCCESS, FAILED
  quotaBytes BigInt // Quota added in bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("payment_transactions")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // e.g., FILE_UPLOAD, FOLDER_CREATE, SHARE_INVITE
  details   String? // JSON formatted details string
  createdAt DateTime @default(now())

  @@map("activity_logs")
}
