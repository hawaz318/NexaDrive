// Prisma Schema for NexaDrive System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Visibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum PermissionRole {
  OWNER
  MANAGER
  EDITOR
  CONTRIBUTOR
  VIEWER
  CUSTOM
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

model User {
  id               String               @id @default(uuid())
  name             String?
  email            String               @unique
  username         String               @unique
  passwordHash     String?
  avatar           String?
  role             Role                 @default(USER)
  isEmailVerified  Boolean              @default(false)
  isActive         Boolean              @default(true)
  storageQuota     BigInt               @default(549755813888) // 512 GB in bytes (512 * 1024^3)
  usedStorage      BigInt               @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  folders          Folder[]             @relation("UserFolders")
  files            File[]               @relation("UserFiles")
  refreshTokens    RefreshToken[]
  oauthAccounts    OAuthAccount[]
  groupMemberships GroupMember[]
  permissions      ResourcePermission[]
  createdShares    Share[]              @relation("CreatedShares")
  receivedShares   Share[]              @relation("ReceivedShares")
  invitationsSent  Invitation[]         @relation("InvitationsSent")
  invitationsRecv  Invitation[]         @relation("InvitationsReceived")
  publicLinks      PublicLink[]
  subscriptions    Subscription[]
  payments         Payment[]
  activityLogs     Activity[]
  notifications    Notification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   // GOOGLE, GITHUB
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model Folder {
  id         String     @id @default(uuid())
  name       String
  parentId   String?
  parent     Folder?    @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders Folder[]   @relation("SubFolders")
  ownerId    String
  owner      User       @relation("UserFolders", fields: [ownerId], references: [id], onDelete: Cascade)
  visibility Visibility @default(PRIVATE)
  isTrashed  Boolean    @default(false)
  trashedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  files       File[]
  permissions ResourcePermission[]
  shares      Share[]
  invitations Invitation[]
  publicLinks PublicLink[]
  trashItem   TrashItem?

  @@map("folders")
}

model File {
  id          String     @id @default(uuid())
  name        String
  size        BigInt
  mimeType    String
  storagePath String
  folderId    String?
  folder      Folder?    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User       @relation("UserFiles", fields: [ownerId], references: [id], onDelete: Cascade)
  visibility  Visibility @default(PRIVATE)
  isTrashed   Boolean    @default(false)
  trashedAt   DateTime?
  currentVer  Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  versions    FileVersion[]
  permissions ResourcePermission[]
  shares      Share[]
  invitations Invitation[]
  publicLinks PublicLink[]
  trashItem   TrashItem?

  @@map("files")
}

model FileVersion {
  id          String   @id @default(uuid())
  fileId      String
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionNum  Int
  storagePath String
  size        BigInt
  createdAt   DateTime @default(now())

  @@map("file_versions")
}

model ResourcePermission {
  id         String         @id @default(uuid())
  role       PermissionRole @default(VIEWER)
  customOps  String[]       // e.g. ["canView", "canEdit", "canDownload"]
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId    String?
  group      Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     Folder?        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileId     String?
  file       File?          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("resource_permissions")
}

model Share {
  id           String         @id @default(uuid())
  folderId     String?
  folder       Folder?        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileId       String?
  file         File?          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("CreatedShares", fields: [createdById], references: [id])
  sharedWithId String?
  sharedWith   User?          @relation("ReceivedShares", fields: [sharedWithId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role         PermissionRole @default(VIEWER)
  createdAt    DateTime       @default(now())

  @@map("shares")
}

model Invitation {
  id           String         @id @default(uuid())
  folderId     String?
  folder       Folder?        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileId       String?
  file         File?          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  invitedById  String
  invitedBy    User           @relation("InvitationsSent", fields: [invitedById], references: [id])
  inviteeEmail String
  inviteeId    String?
  invitee      User?          @relation("InvitationsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  role         PermissionRole @default(VIEWER)
  status       InviteStatus   @default(PENDING)
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())

  @@map("invitations")
}

model PublicLink {
  id            String    @id @default(uuid())
  token         String    @unique @default(uuid())
  folderId      String?
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileId        String?
  file          File?     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  accessKey     String?   // Optional password protection
  expiresAt     DateTime?
  downloadCount Int       @default(0)
  maxDownloads  Int?
  createdAt     DateTime  @default(now())

  @@map("public_links")
}

model Group {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  permissions ResourcePermission[]
  shares      Share[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // ADMIN or MEMBER
  createdAt DateTime @default(now())

  @@map("group_members")
}

model TrashItem {
  id           String   @id @default(uuid())
  folderId     String?  @unique
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileId       String?  @unique
  file         File?    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  originalPath String
  deletedAt    DateTime @default(now())

  @@map("trash_items")
}

model StoragePlan {
  id         String   @id @default(uuid())
  name       String   @unique // e.g. Free, Premium, Business
  priceETB   Float
  quotaBytes BigInt
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  subscriptions Subscription[]

  @@map("storage_plans")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  planId    String
  plan      StoragePlan        @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?

  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  txRef          String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amount         Float
  currency       String        @default("ETB")
  status         String        // PENDING, SUCCESS, FAILED
  provider       String        @default("CHAPA") // CHAPA, TELEBIRR
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("payments")
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // LOGIN, UPLOAD, DOWNLOAD, CREATE_FOLDER, RENAME, MOVE, COPY, DELETE, RESTORE, SHARE, PERMISSION_CHANGE
  details   String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("activities")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // SHARE, DOWNLOAD, QUOTA_ALERT, INVITATION
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
